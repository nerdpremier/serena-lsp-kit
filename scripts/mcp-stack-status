#!/usr/bin/env bash
set -euo pipefail

TUNNEL_DIR="${TUNNEL_DIR:-/root/mcp-workspace/tunnel-client}"
VERSION_FILE="${MCP_TUNNEL_VERSION_FILE:-/usr/local/share/mcp-tunnel-kit/tunnel-client.version}"

if version="$("${TUNNEL_DIR}/tunnel-client" --version 2>/dev/null)"; then
  :
elif [[ -r "$VERSION_FILE" ]]; then
  version="$(cat "$VERSION_FILE")"
else
  version="unavailable"
fi

echo "tunnel_version=$version"
failed=0
for entry in \
  "serena:mcp-serena-tunnel.service:18090" \
  "playwright:mcp-playwright-tunnel.service:18092"; do
  IFS=: read -r name service port <<< "$entry"
  state="$(systemctl is-active "$service" 2>/dev/null || true)"
  if [[ "$state" == "unknown" || "$state" == "inactive" || "$state" == "failed" ]]; then
    if ! systemctl cat "$service" >/dev/null 2>&1; then
      echo "${name}_service=not-installed"
      continue
    fi
  fi
  health="$(curl -fsS --max-time 2 "http://127.0.0.1:${port}/healthz" 2>/dev/null || echo unavailable)"
  ready="$(curl -fsS --max-time 2 "http://127.0.0.1:${port}/readyz" 2>/dev/null || echo unavailable)"
  echo "${name}_service=$state"
  echo "${name}_health=$health"
  echo "${name}_ready=$ready"
  if [[ "$state" != "active" || "$health" != "live" || "$ready" != "ready" ]]; then failed=1; fi
done

tunnels="$(ps -eo comm= | awk '$1=="tunnel-client" {n++} END {print n+0}')"
echo "tunnel_processes=$tunnels"
exit "$failed"
